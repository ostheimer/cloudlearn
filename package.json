{
  "name": "clearn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "lint:eslint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:cloudlearn-smoke": "playwright test -c playwright.cloudlearn.config.ts",
    "release:mobile:check": "pnpm --filter @clearn/mobile release:check",
    "perf:smoke": "tsx --tsconfig apps/api/tsconfig.json scripts/perf-smoke.ts",
    "orchestrator:verify": "./scripts/orchestrator.sh verify",
    "ci": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.58.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.4"
  }
}
