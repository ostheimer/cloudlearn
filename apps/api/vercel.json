{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "regions": ["dub1"],
  "crons": [
    { "path": "/api/v1/push/streak-alerts", "schedule": "0 17 * * *" },
    { "path": "/api/v1/lp/monthly-grant", "schedule": "0 6 1 * *" }
  ]
}
