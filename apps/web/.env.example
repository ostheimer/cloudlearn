# ──────────────────────────────────────────────────────────────
# clearn Web – Environment Variables Template
# Copy to .env.local if you need to override the defaults
# ──────────────────────────────────────────────────────────────

# Basis-URL der clearn API — gilt app-weit (Client via src/lib/api.ts UND die
# Server-Seite für geteilte Decks unter /deck/[token]). Der NEXT_PUBLIC_-Präfix
# ist nötig, damit die Variable auch im Browser-Bundle ankommt.
NEXT_PUBLIC_CLEARN_API_BASE_URL=https://clearn-api.vercel.app

# Optional/veraltet: die Teilen-Seite akzeptiert weiterhin diesen server-seitigen
# Namen. Für neue Setups genügt die NEXT_PUBLIC_-Variable oben.
# CLEARN_API_BASE_URL=https://clearn-api.vercel.app
