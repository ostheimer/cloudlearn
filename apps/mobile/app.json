{
  "expo": {
    "name": "clearn",
    "slug": "clearn",
    "version": "0.1.0",
    "runtimeVersion": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "clearn",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": ["**/*"],
    "platforms": ["ios", "android", "web"],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "clearn benötigt Kamera-Zugriff, um Lernmaterial zu fotografieren und daraus Flashcards zu erstellen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "clearn benötigt Zugriff auf deine Fotos, um Lernmaterial auszuwählen und daraus Flashcards zu erstellen."
        }
      ],
      [
        "expo-notifications",
        {
          "androidMode": "default",
          "androidCollapsedTitle": "clearn"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "app.clearn",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "clearn benötigt Kamera-Zugriff, um Lernmaterial zu fotografieren und daraus Flashcards zu erstellen.",
        "NSPhotoLibraryUsageDescription": "clearn benötigt Zugriff auf deine Fotos, um Lernmaterial auszuwählen und daraus Flashcards zu erstellen.",
        "NSUserTrackingUsageDescription": "Wir verwenden deine Gerätedaten, um relevante Werbung anzuzeigen und clearn kostenlos zu halten.",
        "GADApplicationIdentifier": "ca-app-pub-3940256099942544~1458002511",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.clearn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "updates": {
      "url": "https://u.expo.dev/5495e637-0223-4924-a778-8683dafaf264",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "5495e637-0223-4924-a778-8683dafaf264"
      }
    },
    "owner": "aostheimer"
  }
