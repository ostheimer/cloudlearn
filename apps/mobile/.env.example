# ──────────────────────────────────────────────────────────────
# clearn Mobile – Environment Variables Template
# Expo verwendet EXPO_PUBLIC_* Variablen (client-seitig sichtbar)
# Kopiere nach .env.local und trage deine Werte ein
# ──────────────────────────────────────────────────────────────

# API-Endpunkt (ohne trailing slash)
EXPO_PUBLIC_API_URL=https://clearn-api.vercel.app

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat
# API-Key aus RevenueCat Dashboard → App Settings → API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AdMob – echte App-IDs (aus Google AdMob Dashboard)
# Während der Entwicklung werden automatisch Google Test-IDs verwendet
# Für Production EAS-Build hier die echten IDs eintragen:
EXPO_PUBLIC_ADMOB_APP_IOS_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_APP_ANDROID_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# AdMob – Rewarded Ad Unit IDs (aus AdMob → Apps → Ad Units)
EXPO_PUBLIC_ADMOB_REWARDED_IOS_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
