NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=clearn-uploads
R2_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_SIGNED_URL_TTL_SECONDS=300

POSTHOG_API_KEY=your-posthog-api-key
SENTRY_DSN=your-sentry-dsn

REVENUECAT_WEBHOOK_SECRET=your-revenuecat-secret
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_revenuecat_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_revenuecat_android_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_PRO=pro
# Lifetime-Tier wurde aus revenueCatService.ts entfernt. Nur vorhalten, falls reaktiviert wird.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_LIFETIME=lifetime

# Cron-Secret fuer Supabase Edge Function reset-ai-usage (POST /functions/v1/reset-ai-usage)
CRON_SECRET=your-cron-secret

# AdMob: In Dev/Preview werden Test-IDs genutzt. Fuer Store-Builds echte IDs via EAS Secrets setzen.
EXPO_PUBLIC_ADMOB_APP_IOS_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
EXPO_PUBLIC_ADMOB_APP_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
EXPO_PUBLIC_ADMOB_REWARDED_IOS_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# Legacy: urspruengliches Scan-Limit-System — wird durch das LP-System (packages/contracts/src/featureGates.ts) gesteuert.
FREE_SCAN_LIMIT_PER_MONTH=10
RATE_LIMIT_FREE_PER_MINUTE=60
RATE_LIMIT_PRO_PER_MINUTE=240
