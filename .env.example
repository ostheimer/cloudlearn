NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key

POSTHOG_API_KEY=your-posthog-api-key
SENTRY_DSN=your-sentry-dsn

REVENUECAT_WEBHOOK_SECRET=your-revenuecat-secret
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_revenuecat_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_revenuecat_android_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_PRO=pro
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_LIFETIME=lifetime

# Cron jobs & deck sharing
CRON_SECRET=your-cron-secret
SHARE_LINK_BASE_URL=https://clearn-web.vercel.app

# Free-tier limits & rate limiting
FREE_DECK_LIMIT=10
FREE_CARD_LIMIT=100
RATE_LIMIT_FREE_PER_MINUTE=60
RATE_LIMIT_PRO_PER_MINUTE=240

# --- E2E tests (Playwright, used by e2e/helpers.ts) ---
# Provide these locally in .env or as CI secrets. Never commit real values.
# Rotate TEST_USER_PASSWORD whenever it may have leaked (e.g. issue #76).
SUPABASE_URL=https://your-project.supabase.co
TEST_USER_EMAIL=apitest@clearn.test
TEST_USER_PASSWORD=set-a-strong-unique-password
E2E_API_BASE_URL=https://clearn-api.vercel.app
E2E_WEB_BASE_URL=https://clearn-web.vercel.app
